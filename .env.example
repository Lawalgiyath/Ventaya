# ---------------------------------------------------------------------------
# Ventaya — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Google Gemini (Genkit) ------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Firebase (client SDK — safe to expose, but keep configurable) ---------
# Firebase console → Project settings → Your apps → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only — SECRET) --------------------------------
# Firebase console → Project settings → Service accounts → Generate new private key
# Paste the private key with literal \n escapes, wrapped in double quotes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# --- Stripe (server only — SECRET) ----------------------------------------
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen` or Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=

# --- Stripe Price IDs -----------------------------------------------------
# Create these as recurring prices in the Stripe Dashboard, then paste the IDs.
# B2C
NEXT_PUBLIC_STRIPE_PRICE_PLUS_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PLUS_YEARLY=
# B2B (per-seat: set "Usage type = Licensed" with quantity)
NEXT_PUBLIC_STRIPE_PRICE_TEAM_SEAT=
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS_SEAT=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:9002
